{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "type": "object",
  "properties": {
    "global": {
      "type": "object"
    },
    "projectId": {
      "type": "string",
      "default": ""
    },
    "zone": {
      "type": "string",
      "default": "us-central1-a"
    },
    "machineType": {
      "type": "string",
      "default": "e2-medium"
    },
    "deletionProtection": {
      "type": "boolean",
      "default": false
    },
    "bootDisk": {
      "type": "object",
      "default": {},
      "properties": {
        "size": {
          "type": "integer",
          "default": 20
        },
        "type": {
          "type": "string",
          "default": "pd-standard"
        },
        "sourceImage": {
          "type": "string",
          "default": "debian-cloud/debian-12"
        },
        "autoDelete": {
          "type": "boolean",
          "default": true
        }
      }
    },
    "network": {
      "type": "object",
      "default": {},
      "properties": {
        "network": {
          "type": "string",
          "default": "default"
        },
        "subnetwork": {
          "type": "string",
          "default": ""
        },
        "enableExternalIP": {
          "type": "boolean",
          "default": true
        },
        "networkTier": {
          "type": "string",
          "default": "PREMIUM"
        }
      }
    },
    "tags": {
      "type": "array",
      "default": [],
      "items": {
        "type": "string"
      }
    },
    "metadataStartupScript": {
      "type": "string",
      "default": ""
    }
  }
}
